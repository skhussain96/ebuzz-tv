<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_margin="10dp"
    android:focusable="true" android:clickable="true" android:background="@drawable/tile_bg" android:padding="4dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0"
        android:minHeight="1dp">
        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent" android:layout_height="118dp"
            android:scaleType="centerCrop" android:background="@color/ground2" />
        <TextView
            android:id="@+id/num"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="8dp" android:background="@drawable/num_badge"
            android:paddingHorizontal="9dp" android:paddingVertical="2dp"
            android:textColor="@color/ground" android:textSize="15sp" android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="8dp" android:paddingVertical="8dp"
        android:textColor="@color/ink" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
