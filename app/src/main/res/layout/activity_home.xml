<?xml version="1.0" encoding="utf-8"?>
<world.ebuzz.tv.core.ui.FocusColumn xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ground" android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:gravity="center_vertical">
        <View android:id="@+id/tabSpacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView
            android:id="@+id/btnDevices"
            android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
            android:background="@drawable/tab_bg" android:src="@drawable/ic_cast" android:tint="@color/inkDim"
            android:focusable="true" android:clickable="true" android:contentDescription="Continue from another device" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</world.ebuzz.tv.core.ui.FocusColumn>
