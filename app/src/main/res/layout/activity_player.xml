<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:use_controller="false" app:resize_mode="fit" app:surface_type="surface_view" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center"
        android:indeterminateTint="@color/honey" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
        android:textColor="@color/bad" android:textSize="20sp" android:visibility="gone" />

    <!-- bottom bar: number · name · LIVE -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="@drawable/osd_gradient" android:paddingTop="60dp" android:paddingBottom="28dp"
        android:paddingHorizontal="40dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/osdTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/live" android:textColor="@color/bad" android:textStyle="bold" android:textSize="16sp"
                android:drawablePadding="6dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:background="@drawable/track_fill" />
    </LinearLayout>

    <!-- volume -->
    <LinearLayout
        android:id="@+id/volBox"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="48dp"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/overlay_bg" android:paddingHorizontal="28dp" android:paddingVertical="18dp"
        android:visibility="gone">
        <ImageView android:id="@+id/volIcon" android:layout_width="34dp" android:layout_height="34dp"
            android:src="@android:drawable/ic_lock_silent_mode_off" app:tint="@color/ink" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:layout_marginHorizontal="20dp"
            android:orientation="horizontal" android:background="@drawable/track_bg" android:weightSum="1">
            <View android:id="@+id/volFill" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/track_fill" />
        </LinearLayout>
        <TextView android:id="@+id/volText" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="end" android:textColor="@color/ink" android:textSize="34sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/chNum"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="28dp"
        android:background="@drawable/overlay_bg" android:paddingHorizontal="24dp" android:paddingVertical="6dp"
        android:textColor="@color/honey" android:textSize="52sp" android:textStyle="bold" android:visibility="gone" />

    <ImageView
        android:id="@+id/pausedIcon"
        android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center"
        android:src="@android:drawable/ic_media_pause" app:tint="@color/honey" android:visibility="gone" />
</FrameLayout>
