<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ground" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tabLive" style="@style/Tab" android:text="Live TV" />
            <TextView android:id="@+id/tabMovies" style="@style/Tab" android:text="Movies" android:layout_marginStart="8dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
            android:background="@drawable/search_bg" android:paddingHorizontal="18dp" android:paddingVertical="11dp"
            android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="12dp" android:drawableTint="@color/inkDim"
            android:hint="Search" android:textColorHint="@color/inkDim" android:textColor="@color/ink" android:textSize="16sp"
            android:inputType="text" android:imeOptions="actionSearch|flagNoExtractUi" android:maxLines="1" android:singleLine="true" />

        <!-- Movies filters: every row narrows the same result set (search AND sort AND category) -->
        <LinearLayout
            android:id="@+id/filters"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingTop="6dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/RowLabel" android:text="Sort" />
                <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:scrollbars="none" android:clipToPadding="false" android:paddingVertical="4dp" android:paddingEnd="12dp">
                    <LinearLayout android:id="@+id/sorts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/RowLabel" android:text="Category" />
                <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:scrollbars="none" android:clipToPadding="false" android:paddingVertical="4dp" android:paddingEnd="12dp">
                    <LinearLayout android:id="@+id/chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
            <TextView
                android:id="@+id/resume"
                style="@style/Chip"
                android:layout_width="match_parent" android:layout_marginHorizontal="16dp" android:layout_marginTop="6dp"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/honey" android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:padding="10dp"
            android:focusable="true" android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:textColor="@color/inkDim" android:textSize="18sp"
        android:text="@string/loading" />

    <TextView
        android:id="@+id/chNum"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="28dp"
        android:background="@drawable/overlay_bg" android:paddingHorizontal="24dp" android:paddingVertical="6dp"
        android:textColor="@color/honey" android:textSize="52sp" android:textStyle="bold" android:visibility="gone" />
</FrameLayout>
