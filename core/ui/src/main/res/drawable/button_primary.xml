<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/ink" /><corners android:radius="999dp" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/honey" /><corners android:radius="999dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#D99724" /><corners android:radius="999dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/honey" /><corners android:radius="999dp" /></shape></item>
</selector>
